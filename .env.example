# Copy only the settings you need into .env. Never commit credentials.
PORT=3001
HIVE_COMPANY_NAME=My business
# Optional external configuration; relative paths resolve from the software directory.
# HIVE_ENV_FILE=/absolute/path/to/private-instance.env
# HIVE_CONFIG_DIR=/absolute/path/to/private-config
# HIVE_PAYMENT_INFO_FILE=/absolute/path/to/Payment_Info_Venmo_Crypto.txt
HIVE_DATA_DIR=data
HIVE_WORKER_ENABLED=true
# Temporary local testing only; false restores dashboard sign-in after restart.
HIVE_DASHBOARD_AUTH_DISABLED=false
# Optional; otherwise generated in data/owner-token.txt
# HIVE_OWNER_TOKEN=at-least-16-random-characters

LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Leave unpinned to discover a currently loaded model.
# LMSTUDIO_MODEL=exact-model-id
# LMSTUDIO_API_KEY=

# A key alone does not enable a remote model. Configure ID and current USD prices.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_INPUT_PER_MILLION_USD=
OPENAI_OUTPUT_PER_MILLION_USD=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_INPUT_PER_MILLION_USD=
ANTHROPIC_OUTPUT_PER_MILLION_USD=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_INPUT_PER_MILLION_USD=
GEMINI_OUTPUT_PER_MILLION_USD=

# Optional SMS; also enable in dashboard after configuring all fields.
# Outbound API key authentication (optional; account authentication remains supported).
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Existing TWILIO_SID / TWILIO_CLIENT_SECRET aliases are also accepted.
# Account auth token is still required to verify incoming approval replies.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
HIVE_SMS_FROM=
HIVE_SMS_TO=
# Optional: leave unset for notification-only mode.
HIVE_SMS_WEBHOOK_URL=
HIVE_SMS_MAX_COST_USD=
HIVE_SMS_DAILY_CAP_USD=
# Runtime budgets are persisted and edited in Owner controls, not read from env.

# Optional automatic static publishing (requires an exact approval for each release).
HIVE_NETLIFY_ENABLED=false
HIVE_NETLIFY_TOKEN=
HIVE_NETLIFY_SITE_ID=
# Explicit owner estimates/bounds, not provider quotes. Unknown charges stay reserved.
HIVE_NETLIFY_MAX_DEPLOY_USD=
HIVE_NETLIFY_TOTAL_CAP_USD=

# Google Workspace mailbox OAuth web client (Gmail API enabled).
HIVE_GMAIL_CLIENT_ID=
HIVE_GMAIL_CLIENT_SECRET=
HIVE_GMAIL_REDIRECT_URI=http://127.0.0.1:3001/email/oauth/callback
# Address of the Gmail/Workspace account you will connect. Empty disables email setup.
HIVE_BUSINESS_EMAIL=
# The refresh token is encrypted in Hive; data/email-token.key stays server-side.
# GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET are accepted aliases.
# Google consent stores an encrypted refresh token; no token needs to be pasted into chat.
# Optional web search. No search calls are available until all three are configured.
# HIVE_SEARCH_PROVIDER=brave
# BRAVE_SEARCH_API_KEY=
# Set the per-query price under your provider contract; 0 is explicit free usage.
# HIVE_SEARCH_COST_USD=
